+static gboolean
+uses_output_frc (ClutterStageViewPrivate *priv)
+{
+  const ClutterLuminance *luminance;
+  const ClutterEOTF *eotf;
+
+  if (!priv->output_frc_enabled ||
+      !CLUTTER_IS_COLOR_STATE_PARAMS (priv->output_color_state))
+    return FALSE;
+
+  luminance = clutter_color_state_get_luminance (priv->output_color_state);
+  eotf = clutter_color_state_params_get_eotf (
+    CLUTTER_COLOR_STATE_PARAMS (priv->output_color_state));
+
+  return eotf->type == CLUTTER_EOTF_TYPE_NAMED &&
+         eotf->tf_name == CLUTTER_TRANSFER_FUNCTION_GAMMA22 &&
+         luminance->type == CLUTTER_LUMINANCE_TYPE_EXPLICIT &&
+         luminance->max > luminance->ref;
