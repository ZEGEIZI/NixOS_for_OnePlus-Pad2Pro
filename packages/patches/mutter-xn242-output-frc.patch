+static void
+add_output_frc (ClutterStageViewPrivate *priv,
+                CoglPipeline            *pipeline)
+{
+  g_autoptr (CoglSnippet) snippet = NULL;
+
+  /* A 4x4 Bayer tile contains each threshold on every refresh. Rotate
+   * the thresholds by five so each pixel visits all sixteen phases. */
+  snippet = cogl_snippet_new (
+    COGL_SNIPPET_HOOK_FRAGMENT,
+    "uniform highp float output_frc_phase;\n"
+    "highp float output_frc_bayer2 (highp vec2 p) {\n"
+    "  return 2.0 * abs (p.x - p.y) + p.y;\n"
+    "}\n",
+    "highp vec2 pixel = mod (floor (gl_FragCoord.xy), 4.0);\n"
+    "highp float rank = 4.0 * output_frc_bayer2 (mod (pixel, 2.0)) +\n"
+    "                   output_frc_bayer2 (floor (pixel * 0.5));\n"
+    "rank = mod (rank + output_frc_phase, 16.0);\n"
+    "highp vec3 value = floor (clamp (cogl_color_out.rgb, 0.0, 1.0) * 4080.0 + 0.5);\n"
+    "highp vec3 base = floor (value * 0.0625);\n"
+    "highp vec3 code = base + step (vec3 (rank + 1.0), value - 16.0 * base);\n"
+    /* Place the chosen 8-bit code in the high bits of the XR30 channel.
+     * This leaves zero fractional bits for the DPU's 10-to-8 dither. */
+    "cogl_color_out.rgb = code * (4.0 / 1023.0);\n");
+  cogl_pipeline_add_snippet (pipeline, snippet);
+  priv->output_frc_phase_uniform =
+    cogl_pipeline_get_uniform_location (pipeline, "output_frc_phase");
 }
 
