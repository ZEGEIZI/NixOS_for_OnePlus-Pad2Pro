+static void
+sample_adaptive_hdr (ClutterStageView *view)
+{
+  ClutterStageViewPrivate *priv = clutter_stage_view_get_instance_private (view);
+  CoglTexture *texture = cogl_offscreen_get_texture (priv->offscreen);
+  CoglContext *ctx = cogl_framebuffer_get_context (priv->framebuffer);
+  gint64 now = g_get_monotonic_time ();
+  uint8_t result[4];
+  int level;
+
+  if (!uses_adaptive_hdr (priv))
+    return;
+  if (now - priv->adaptive_hdr_last_sample < 100000)
+    {
+      if (!priv->adaptive_hdr_sample_timeout)
+        priv->adaptive_hdr_sample_timeout = g_timeout_add (
+          (100000 - (now - priv->adaptive_hdr_last_sample)) / 1000 + 1,
+          queue_adaptive_hdr_sample, view);
+      return;
+    }
+  g_clear_handle_id (&priv->adaptive_hdr_sample_timeout, g_source_remove);
+  priv->adaptive_hdr_last_sample = now;
+  if (!priv->adaptive_hdr_reduction)
+    {
+      g_autoptr (CoglSnippet) snippet = cogl_snippet_new (
+        COGL_SNIPPET_HOOK_FRAGMENT,
+        "uniform highp vec4 xn242_size;\n", NULL);
+      cogl_snippet_set_replace (snippet,
+        "highp vec2 base = floor(cogl_tex_coord0_in.st * xn242_size.zw) * 4.0;\n"
+        "highp vec3 peak = vec3(0.0);\n"
+        "for (int y=0; y<4; y++) for (int x=0; x<4; x++) {\n"
+        "  highp vec2 uv = (base + vec2(float(x),float(y)) + 0.5) / xn242_size.xy;\n"
+        "  peak = max(peak, texture2D(cogl_sampler0, uv).rgb);\n"
+        "}\n"
+        "cogl_color_out = vec4(peak, 1.0);\n");
+      priv->adaptive_hdr_reduction = cogl_pipeline_new (ctx);
+      cogl_pipeline_add_snippet (priv->adaptive_hdr_reduction, snippet);
+      cogl_pipeline_set_blend (priv->adaptive_hdr_reduction, "RGBA = ADD (SRC_COLOR, 0)", NULL);
+      cogl_pipeline_set_layer_filters (priv->adaptive_hdr_reduction, 0,
+                                       COGL_PIPELINE_FILTER_NEAREST, COGL_PIPELINE_FILTER_NEAREST);
+      cogl_pipeline_set_layer_wrap_mode (priv->adaptive_hdr_reduction, 0,
+                                         COGL_PIPELINE_WRAP_MODE_CLAMP_TO_EDGE);
+    }
+  for (level = 0; level < 12; level++)
+    {
+      int width = cogl_texture_get_width (texture);
+      int height = cogl_texture_get_height (texture);
+      int next_width = (width + 3) / 4;
+      int next_height = (height + 3) / 4;
+      CoglFramebuffer *fb;
+      float dimensions[4] = { width, height, next_width, next_height };
+      int location;
+      if (!priv->adaptive_hdr_levels[level])
+        {
+          CoglPixelFormat format = COGL_PIXEL_FORMAT_RGBA_8888_PRE;
+          priv->adaptive_hdr_levels[level] = cogl_offscreen_new_from_formats (
+            ctx, &format, 1, next_width, next_height, NULL);
+          if (!priv->adaptive_hdr_levels[level])
+            return;
+        }
