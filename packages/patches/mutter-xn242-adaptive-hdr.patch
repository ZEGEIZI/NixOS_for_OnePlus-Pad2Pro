+static gboolean
+uses_adaptive_hdr (ClutterStageViewPrivate *priv)
+{
+  const ClutterEOTF *eotf;
+  if (!priv->adaptive_hdr_enabled ||
+      !CLUTTER_IS_COLOR_STATE_PARAMS (priv->color_state))
+    return FALSE;
+  eotf = clutter_color_state_params_get_eotf (CLUTTER_COLOR_STATE_PARAMS (priv->color_state));
+  return eotf->type == CLUTTER_EOTF_TYPE_NAMED &&
+         eotf->tf_name == CLUTTER_TRANSFER_FUNCTION_GAMMA22;
+}
+
+static void
+add_adaptive_hdr (ClutterStageViewPrivate *priv,
+                  CoglPipeline            *pipeline)
+{
+  g_autoptr (CoglSnippet) snippet = cogl_snippet_new (
+    COGL_SNIPPET_HOOK_FRAGMENT,
+    "uniform highp vec2 xn242_backlight;\n",
+    "highp vec3 light = pow(max(cogl_color_out.rgb, vec3(0.0)), vec3(2.2)) * 561.5;\n"
+    "highp float peak = max(light.r, max(light.g, light.b));\n"
+    "highp float available = max(xn242_backlight.x, 0.01);\n"
+    "highp float knee = max(min(xn242_backlight.y, available * 0.98), available * 0.95);\n"
+    /* Temporary monotonic shoulder while hardware is catching up. SDR white
+     * below available stays unchanged; saturated RGB is scaled together. */
+    "if (peak > knee && available < 561.0) {\n"
+    "  highp float span = max(available - knee, 0.001);\n"
+    "  highp float mapped = knee + span * (1.0 - exp(-(peak-knee)/span));\n"
+    "  light *= mapped / peak;\n"
+    "}\n"
+    "cogl_color_out.rgb = pow(clamp(light / available, 0.0, 1.0), vec3(1.0/2.2));\n");
+  float values[2] = { priv->adaptive_hdr_peak, priv->adaptive_hdr_reference };
+  cogl_pipeline_add_snippet (pipeline, snippet);
+  priv->adaptive_hdr_uniform = cogl_pipeline_get_uniform_location (pipeline, "xn242_backlight");
+  cogl_pipeline_set_uniform_float (pipeline, priv->adaptive_hdr_uniform, 2, 1, values);
+}
+
+/* Exact maximum reduction, not a sparse thumbnail: a one-pixel highlight
+ * survives all 4x4 stages. Only four bytes reach the CPU, at most ten times a
+ * second and only on an already painted frame. This never drives an idle view
+ * at the refresh rate. Sampling precedes physical-backlight compensation/FRC. */
+static gboolean
+queue_adaptive_hdr_sample (gpointer data)
+{
+  ClutterStageView *view = data;
+  ClutterStageViewPrivate *priv = clutter_stage_view_get_instance_private (view);
+  priv->adaptive_hdr_sample_timeout = 0;
+  if (uses_adaptive_hdr (priv))
+    {
+      clutter_stage_view_add_redraw_clip (view, NULL);
+      clutter_stage_view_schedule_update (view);
+    }
+  return G_SOURCE_REMOVE;
+}
