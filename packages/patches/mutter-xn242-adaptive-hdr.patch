+      cogl_framebuffer_set_dither_enabled (fb, FALSE);
+      cogl_framebuffer_orthographic (fb, 0, 0, next_width, next_height, -1, 1);
+      cogl_pipeline_set_layer_texture (priv->adaptive_hdr_reduction, 0, texture);
+      location = cogl_pipeline_get_uniform_location (priv->adaptive_hdr_reduction, "xn242_size");
+      cogl_pipeline_set_uniform_float (priv->adaptive_hdr_reduction, location, 4, 1, dimensions);
+      cogl_framebuffer_draw_textured_rectangle (fb, priv->adaptive_hdr_reduction,
