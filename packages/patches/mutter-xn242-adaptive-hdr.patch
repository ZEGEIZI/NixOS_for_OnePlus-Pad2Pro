+typedef struct
+{
+  ClutterStageView *view; /* Owned by the view, never reference the owner. */
+  MetaBackend *backend;
+  MetaColorDevice *color_device;
+  MetaBacklight *hardware;
+  gboolean hdr;
+  float refresh;
+  double observed_peak;
+  double held_peak;
+  double available;
+  double reference;
+  gint64 last_highlight;
+  gint64 last_tick;
+  guint tick_id;
+  int actual_code;
+  int target_code;
+} Xn242Controller;
+
+static Xn242Controller *active;
+static guint requested_precision = 10;
+static gboolean last_hdr;
+static guint bus_owner;
+
+static int
+read_backlight (const char *attribute, int fallback)
+{
+  g_autofree char *path = g_build_filename ("/sys/class/backlight/backlight", attribute, NULL);
+  g_autofree char *text = NULL;
+  if (!g_file_get_contents (path, &text, NULL, NULL))
+    return fallback;
+  return (int) g_ascii_strtoll (text, NULL, 10);
+}
+
+gboolean
+meta_xn242_adaptive_hdr_enabled (const MetaOutputInfo *info)
+{
+  return meta_xn242_has_native_hdr (info) &&
+         g_file_test ("/etc/mutter/xn242-adaptive-hdr", G_FILE_TEST_IS_REGULAR);
+}
+
+static void schedule_tick (Xn242Controller *controller);
+
+static gboolean
+controller_tick (gpointer user_data)
+{
+  Xn242Controller *c = user_data;
+  gint64 now = g_get_monotonic_time ();
+  double elapsed = MIN (0.2, MAX (0.001, (now - c->last_tick) / 1000000.0));
+  double reference = 203.0 * meta_color_device_get_reference_luminance_factor (c->color_device);
+  int next;
+
+  c->tick_id = 0;
+  c->last_tick = now;
+  if (!c->hdr || !c->hardware ||
+      meta_monitor_manager_get_power_save_mode (meta_backend_get_monitor_manager (c->backend)) != META_POWER_SAVE_ON ||
+      read_backlight ("bl_power", 4) != 0)
+    return G_SOURCE_REMOVE;
+
+  c->reference = CLAMP (reference, 1.0, XN242_PEAK_NITS * 0.95);
+  if (c->observed_peak >= c->held_peak)
+    {
+      c->held_peak = c->observed_peak;
+      c->last_highlight = now;
+    }
+  else if (now - c->last_highlight > XN242_HIGHLIGHT_HOLD_US)
+    c->held_peak = c->observed_peak + (c->held_peak - c->observed_peak) * exp (-elapsed / 0.45);
+
+  c->actual_code = read_backlight ("actual_brightness", c->actual_code);
+  if (c->actual_code <= 0)
+    return G_SOURCE_REMOVE;
+  c->available = xn242_peak_for_code (c->actual_code);
+  c->target_code = xn242_code_for_peak (xn242_target_peak (c->reference, c->held_peak));
+  clutter_stage_view_set_adaptive_hdr (c->view, TRUE, c->available, c->reference);
+  next = xn242_slew_code (c->actual_code, c->target_code);
+  if (next != c->actual_code && !meta_backlight_has_pending (c->hardware))
+    meta_backlight_set_brightness (c->hardware, next);
+
+  if (next != c->actual_code || fabs (c->held_peak - c->observed_peak) > 0.05 ||
+      meta_backlight_has_pending (c->hardware))
+    schedule_tick (c);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+schedule_tick (Xn242Controller *c)
+{
+  if (!c->tick_id && c->hdr)
+    c->tick_id = g_timeout_add (25, controller_tick, c);
+}
+
+static void
+on_sample (ClutterStageView *view, double peak, Xn242Controller *c)
+{
+  c->observed_peak = isfinite (peak) ? CLAMP (peak, 0, XN242_PEAK_NITS) : XN242_PEAK_NITS;
+  schedule_tick (c);
+}
+
+static void
+on_reference_changed (MetaColorDevice *device, Xn242Controller *c)
+{
+  schedule_tick (c);
+}
+
+static void
+on_hardware_changed (MetaBacklight *backlight, GParamSpec *pspec, Xn242Controller *c)
+{
+  schedule_tick (c);
+}
+
+static void
+controller_free (gpointer data)
+{
+  Xn242Controller *c = data;
+  if (active == c)
+    active = NULL;
+  g_clear_handle_id (&c->tick_id, g_source_remove);
+  g_signal_handlers_disconnect_by_data (c->view, c);
+  g_signal_handlers_disconnect_by_data (c->color_device, c);
+  if (c->hardware)
+    g_signal_handlers_disconnect_by_data (c->hardware, c);
+  g_clear_object (&c->hardware);
+  g_clear_object (&c->color_device);
+  g_free (c);
+}
+
+static void
+on_view_destroy (ClutterStageView *view, Xn242Controller *c)
+{
+  g_object_set_data (G_OBJECT (view), "xn242-controller", NULL);
+}
+
+static const char dbus_xml[] =
+  "<node><interface name='org.gnome.Mutter.Xn242'>"
+  "<method name='SetPrecision'><arg name='bits' type='u' direction='in'/></method>"
+  "<method name='GetState'><arg name='state' type='a{sv}' direction='out'/></method>"
+  "</interface></node>";
+
+static void
+handle_method (GDBusConnection *connection, const char *sender, const char *path,
+                const char *interface, const char *method, GVariant *parameters,
+                GDBusMethodInvocation *invocation, gpointer data)
+{
+  Xn242Controller *c = active;
+  if (!c)
+    {
+      g_dbus_method_invocation_return_error (invocation, G_IO_ERROR, G_IO_ERROR_NOT_CONNECTED,
+                                              "XN242 output is not active");
+      return;
+    }
+  if (g_str_equal (method, "SetPrecision"))
+    {
+      guint bits;
+      g_variant_get (parameters, "(u)", &bits);
+      if ((bits != 10 && bits != 12) || !c->hdr || (bits == 12 && c->refresh < 100))
+        {
+          g_dbus_method_invocation_return_error (invocation, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+            "Enable HDR first; precision must be 10 or 12, and 12 requires at least 100 Hz");
+          return;
+        }
+      requested_precision = bits;
+      clutter_stage_view_set_output_frc (c->view, bits == 12);
+      g_message ("XN242 HDR precision selected: %u-bit", bits);
+      g_dbus_method_invocation_return_value (invocation, NULL);
+    }
+  else if (g_str_equal (method, "GetState"))
+    {
+      GVariantBuilder b;
+      gboolean asleep = read_backlight ("bl_power", 4) != 0;
+      guint bits = clutter_stage_view_get_output_frc (c->view) ? 12 : 10;
+      g_variant_builder_init (&b, G_VARIANT_TYPE_VARDICT);
+      g_variant_builder_add (&b, "{sv}", "connector", g_variant_new_string ("DSI-1"));
+      g_variant_builder_add (&b, "{sv}", "compositor-pid", g_variant_new_uint32 (getpid ()));
+      g_variant_builder_add (&b, "{sv}", "hdr", g_variant_new_boolean (c->hdr));
+      g_variant_builder_add (&b, "{sv}", "precision", g_variant_new_uint32 (c->hdr ? bits : 10));
+      g_variant_builder_add (&b, "{sv}", "requested-precision", g_variant_new_uint32 (requested_precision));
+      g_variant_builder_add (&b, "{sv}", "adaptive-backlight", g_variant_new_boolean (c->hdr && c->hardware != NULL));
+      g_variant_builder_add (&b, "{sv}", "asleep", g_variant_new_boolean (asleep));
+      g_variant_builder_add (&b, "{sv}", "backlight-code", g_variant_new_int32 (read_backlight ("actual_brightness", 0)));
+      g_variant_builder_add (&b, "{sv}", "target-backlight-code", g_variant_new_int32 (c->target_code));
+      g_variant_builder_add (&b, "{sv}", "estimated-available-nits", g_variant_new_double (c->available));
+      g_variant_builder_add (&b, "{sv}", "estimated-reference-nits", g_variant_new_double (c->reference));
+      g_variant_builder_add (&b, "{sv}", "mapped-content-peak-nits", g_variant_new_double (c->observed_peak));
+      g_variant_builder_add (&b, "{sv}", "panel-peak-reference-nits", g_variant_new_double (XN242_PEAK_NITS));
+      g_variant_builder_add (&b, "{sv}", "luminance-calibrated", g_variant_new_boolean (FALSE));
+      g_dbus_method_invocation_return_value (invocation, g_variant_new ("(a{sv})", &b));
+    }
+}
+
+static const GDBusInterfaceVTable dbus_vtable = { .method_call = handle_method };
+
+static void
+on_bus_acquired (GDBusConnection *connection, const char *name, gpointer data)
+{
+  GDBusNodeInfo *info = g_dbus_node_info_new_for_xml (dbus_xml, NULL);
+  g_dbus_connection_register_object (connection, "/org/gnome/Mutter/Xn242",
+                                      info->interfaces[0], &dbus_vtable, NULL, NULL, NULL);
+  g_dbus_node_info_unref (info);
+}
+
+void
+meta_xn242_attach_output (ClutterStageView *view, MetaBackend *backend,
+                          MetaColorDevice *device, MetaMonitor *monitor,
+                          gboolean hdr, float refresh)
+{
+  Xn242Controller *c = g_new0 (Xn242Controller, 1);
+  MetaBacklight *virtual_backlight = meta_monitor_get_backlight (monitor);
+  c->view = view;
+  c->backend = backend;
+  c->color_device = g_object_ref (device);
+  c->hdr = hdr;
+  c->refresh = refresh;
+  c->reference = CLAMP (203.0 * meta_color_device_get_reference_luminance_factor (device), 1, XN242_PEAK_NITS * 0.95);
+  c->observed_peak = c->reference;
+  c->held_peak = c->reference;
+  c->actual_code = read_backlight ("actual_brightness", XN242_MAX_CODE);
+  c->available = xn242_peak_for_code (c->actual_code);
+  c->last_tick = g_get_monotonic_time ();
+  if (hdr)
+    {
+      if (virtual_backlight)
+        c->hardware = g_object_get_data (G_OBJECT (virtual_backlight), "-mutter-output-kms-sysfs");
+      if (c->hardware)
+        g_object_ref (c->hardware);
+      else
+        c->hardware = META_BACKLIGHT (meta_backlight_sysfs_new (backend,
+          meta_output_get_info (meta_monitor_get_main_output (monitor)), NULL));
+    }
+  if (hdr && !last_hdr)
+    requested_precision = g_file_test ("/etc/mutter/xn242-output-frc", G_FILE_TEST_IS_REGULAR) ? 12 : 10;
+  last_hdr = hdr;
+  active = c;
+  g_object_set_data_full (G_OBJECT (view), "xn242-controller", c, controller_free);
+  g_signal_connect (view, "destroy", G_CALLBACK (on_view_destroy), c);
+  clutter_stage_view_set_output_frc (view, hdr && requested_precision == 12 && refresh >= 100);
+  if (hdr && c->hardware)
+    {
+      clutter_stage_view_set_adaptive_hdr (view, TRUE, c->available, c->reference);
+      g_signal_connect (view, "adaptive-hdr-sample", G_CALLBACK (on_sample), c);
+      g_signal_connect (device, "color-state-changed", G_CALLBACK (on_reference_changed), c);
+      g_signal_connect (c->hardware, "notify::brightness", G_CALLBACK (on_hardware_changed), c);
+      schedule_tick (c);
+    }
+  if (!bus_owner)
+    bus_owner = g_bus_own_name (G_BUS_TYPE_SESSION, "org.gnome.Mutter.Xn242",
+                                 G_BUS_NAME_OWNER_FLAGS_NONE, on_bus_acquired, NULL, NULL, NULL, NULL);
+  g_message ("XN242 adaptive output: HDR=%d precision=%u reference=%.2f estimated nit, backlight=%d",
+               hdr, hdr && requested_precision == 12 && refresh >= 100 ? 12 : 10,
+               c->reference, c->actual_code);
+}
