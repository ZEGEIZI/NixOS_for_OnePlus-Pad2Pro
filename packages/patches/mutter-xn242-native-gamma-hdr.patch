diff --git a/src/backends/meta-xn242-hdr.h b/src/backends/meta-xn242-hdr.h
new file mode 100644
index 0000000..578ba2a
--- /dev/null
+++ b/src/backends/meta-xn242-hdr.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <string.h>
+
+#include "backends/meta-output.h"
+
+/* The XN242 accepts RGB888/DSC, with a gamma 2.2 response in the factory
+ * HDR pipeline. Keep all color conversion in the compositor and leave the
+ * KMS connector in its default encoding. Only the dedicated test system
+ * installs the opt-in marker. */
+static inline gboolean
+meta_xn242_has_native_hdr (const MetaOutputInfo *info)
+{
+  static gsize checked;
+  static gboolean enabled;
+
+  if (!info || info->is_virtual ||
+      info->connector_type != META_CONNECTOR_TYPE_DSI ||
+      g_strcmp0 (info->name, "DSI-1") != 0)
+    return FALSE;
+
+  if (g_once_init_enter (&checked))
+    {
+      g_autofree char *compatible = NULL;
+      g_autofree char *max_brightness = NULL;
+      gsize length = 0;
+
+      enabled =
+        g_file_test ("/etc/mutter/xn242-native-hdr", G_FILE_TEST_IS_REGULAR) &&
+        g_file_get_contents ("/sys/firmware/devicetree/base/compatible",
+                             &compatible, &length, NULL) &&
+        length >= sizeof ("oneplus,opd2413") &&
+        memcmp (compatible, "oneplus,opd2413", sizeof ("oneplus,opd2413")) == 0 &&
+        g_file_test ("/sys/firmware/devicetree/base/soc@0/display-subsystem@ae00000/"
+                     "dsi@ae94000/panel@0/qcom,dpu-8bpc-dither",
+                     G_FILE_TEST_EXISTS) &&
+        g_file_get_contents ("/sys/class/backlight/backlight/max_brightness",
+                             &max_brightness, NULL, NULL) &&
+        g_str_equal (g_strstrip (max_brightness), "2047");
+      g_once_init_leave (&checked, 1);
+    }
+
+  return enabled;
+}
