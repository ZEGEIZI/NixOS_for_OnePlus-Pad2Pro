+struct _ClutterColorOpHdrShoulder
+{
+  ClutterColorOp parent_instance;
+  float knee;
+};
+
+G_DEFINE_TYPE (ClutterColorOpHdrShoulder, clutter_color_op_hdr_shoulder,
+               CLUTTER_TYPE_COLOR_OP)
+
+static char *
+clutter_color_op_hdr_shoulder_to_string (ClutterColorOp *op)
+{
+  return g_strdup ("hdr-shoulder");
+}
+
+/* Linear-light RGB shoulder with unit slope at SDR white. Scale the three
+ * channels together so that highlight compression does not change hue. */
+static void
+clutter_color_op_hdr_shoulder_do_transform (ClutterColorOp *op,
+                                           float          *data,
+                                           size_t          n_pixels)
+{
+  float knee = CLUTTER_COLOR_OP_HDR_SHOULDER (op)->knee;
+  float headroom = 1.0f - knee;
+
+  for (size_t i = 0; i < n_pixels; i++, data += 4)
+    {
+      float peak = MAX (data[0], MAX (data[1], data[2]));
+
+      if (peak > knee)
+        {
+          float excess = peak - knee;
+          float scale = (knee + headroom * (excess / (excess + headroom))) / peak;
+
+          data[0] *= scale;
+          data[1] *= scale;
+          data[2] *= scale;
+        }
+    }
+}
+
+static void
+clutter_color_op_hdr_shoulder_class_init (ClutterColorOpHdrShoulderClass *klass)
+{
+  ClutterColorOpClass *op_class = CLUTTER_COLOR_OP_CLASS (klass);
+
+  op_class->to_string = clutter_color_op_hdr_shoulder_to_string;
+  op_class->do_transform = clutter_color_op_hdr_shoulder_do_transform;
+}
+
+static void
+clutter_color_op_hdr_shoulder_init (ClutterColorOpHdrShoulder *op)
+{
+}
+
+ClutterColorOp *
+clutter_color_op_hdr_shoulder_new (float knee)
+{
+  ClutterColorOpHdrShoulder *op = g_object_new (CLUTTER_TYPE_COLOR_OP_HDR_SHOULDER, NULL);
+
+  op->knee = CLAMP (knee, 0.001f, 0.95f);
+  return CLUTTER_COLOR_OP (op);
+}
+
+float
+clutter_color_op_hdr_shoulder_get_knee (ClutterColorOp *op)
+{
+  return CLUTTER_COLOR_OP_HDR_SHOULDER (op)->knee;
+}
