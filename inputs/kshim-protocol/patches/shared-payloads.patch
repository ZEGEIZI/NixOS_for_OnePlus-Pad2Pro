+def payload_digest(source, kind):
+    """Inspect a regular source without following a final symlink."""
+    fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW)
+    try:
+        before = os.fstat(fd)
+        if not stat.S_ISREG(before.st_mode) or not 0 < before.st_size <= FILE_MAX:
+            raise ValueError('Invalid/oversized ' + kind)
+        with os.fdopen(os.dup(fd), 'rb') as stream:
+            validate_payload_header(stream.read(64), before.st_size, kind)
+            stream.seek(0)
+            digest = hashlib.file_digest(stream, 'sha256').hexdigest()
+        after = os.fstat(fd)
+        if (before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (
+                after.st_size, after.st_mtime_ns, after.st_ctime_ns):
+            raise ValueError('Source changed during hashing')
+        return before.st_size, digest
+    finally:
+        os.close(fd)
+
+
+def reusable_payloads(system, listed, expected):
+    """Find matching payloads only in verified versions of this system."""
+    found = {}
+    for version in listed:
+        try:
+            manifest = version_manifest(system, version, verify_payloads=False)
+            matching = [key for key, (size, digest) in expected.items()
+                        if key not in found and manifest.get(key) != 'none'
+                        and manifest.get(key + '_size') == str(size)
+                        and manifest.get(key + '_sha256') == digest]
+            if not matching:
+                continue
+            # Verify real bytes, paths and all companion files before reusing
+            # anything. A broken old entry must not infect a new generation.
+            version_manifest(system, version)
+        except (OSError, ValueError):
+            continue
+        for key in matching:
+            found[key] = system/'versions'/version/manifest[key]
+        if len(found) == len(expected):
+            break
+    return found
+
+
+def link_payload(source, dest, kind, expected):
+    # Callers hold the system update lock. Never overwrite or chmod a shared
+    # inode: every published version treats its payloads as immutable.
+    if payload_digest(source, kind) != expected:
+        raise ValueError('Reusable payload changed before linking')
+    os.link(source, dest, follow_symlinks=False)
+    if payload_digest(dest, kind) != expected:
+        raise ValueError('Linked payload failed verification')
+    return expected
+
+
