+static int novatek_nt36536_off(struct novatek_nt36536 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi[1] };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 10);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 65);
+
+	return dsi_ctx.accum_err;
+}
+
+/*
+ * Supply sequence of the XN242 module, taken from the vendor kernel: the panel
+ * power sequence (vddio, then 2 ms; 5 ms before vddio goes off) and the
+ * KTZ8868 bias switching (OUTP, 8 ms, OUTN, 10 ms on the way up; 2 ms, OUTN,
+ * 8 ms, OUTP, 10 ms on the way down).
+ */
+static int novatek_nt36536_power_on(struct novatek_nt36536 *ctx)
+{
+	int ret;
+
+	ret = regulator_enable(ctx->vddio);
+	if (ret < 0)
+		return ret;
+	usleep_range(2000, 3000);
+
+	ret = regulator_enable(ctx->vsp);
+	if (ret < 0)
+		goto err_vddio;
+	usleep_range(8000, 9000);
+
+	ret = regulator_enable(ctx->vsn);
+	if (ret < 0)
+		goto err_vsp;
+	usleep_range(10000, 11000);
+
+	return 0;
+
+err_vsp:
+	regulator_disable(ctx->vsp);
+	usleep_range(10000, 11000);
+err_vddio:
+	usleep_range(5000, 6000);
+	regulator_disable(ctx->vddio);
+
+	return ret;
+}
+
+static void novatek_nt36536_power_off(struct novatek_nt36536 *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(2000, 3000);
+
+	regulator_disable(ctx->vsn);
+	usleep_range(8000, 9000);
+
+	/* 10 ms after OUTP, then the 5 ms the panel needs before vddio goes */
+	regulator_disable(ctx->vsp);
+	usleep_range(15000, 16000);
+
+	regulator_disable(ctx->vddio);
+}
+
+static int novatek_nt36536_prepare(struct drm_panel *panel)
+{
+	struct novatek_nt36536 *ctx = to_novatek_nt36536(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi[1] };
+	int ret;
+
+	ret = novatek_nt36536_power_on(ctx);
+	if (ret < 0)
+		return ret;
+
+	novatek_nt36536_reset(ctx);
+
+	/*
+	 * The stock sequence configures the panel's DSC decoder solely through
+	 * the vendor 0x91 blob in the on-commands; it never receives a DCS PPS
+	 * or a compression-mode packet. Sending the standard PPS afterwards
+	 * re-programmed the decoder with full-width (3392) semantics while each
+	 * DSI link only carries 1696 px, so the decoder starved -- black screen.
+	 */
+	ret = novatek_nt36536_on(ctx);
+	if (ret < 0)
+		goto err;
+
+	if (dsi_ctx.accum_err) {
+		ret = dsi_ctx.accum_err;
+		goto err;
+	}
+
+	return 0;
+
+err:
+	novatek_nt36536_power_off(ctx);
+
+	return ret;
+}
+
+static int novatek_nt36536_unprepare(struct drm_panel *panel)
+{
+	struct novatek_nt36536 *ctx = to_novatek_nt36536(panel);
+	struct device *dev = &ctx->dsi[0]->dev;
+	int ret;
+
+	ret = novatek_nt36536_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "failed to off panel: %d\n", ret);
+
+	novatek_nt36536_power_off(ctx);
+
+	return 0;
+}
+
+static const struct drm_display_mode novatek_nt36536_mode = {
+	.clock = (1696 + 50 + 32 + 64) * 2 * (2400 + 26 + 2 + 230) * 120 / 1000,
+	.hdisplay = 1696 * 2,
+	.hsync_start = (1696 + 50) * 2,
+	.hsync_end = (1696 + 50 + 32) * 2,
+	.htotal = (1696 + 50 + 32 + 64) * 2,
+	.vdisplay = 2400,
+	.vsync_start = 2400 + 26,
+	.vsync_end = 2400 + 26 + 2,
+	.vtotal = 2400 + 26 + 2 + 230,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int novatek_nt36536_get_modes(struct drm_panel *panel,
+				     struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	connector->display_info.width_mm = 274;
+	connector->display_info.height_mm = 193;
+	connector->display_info.bpc = 8;
+
+	mode = drm_mode_duplicate(connector->dev, &novatek_nt36536_mode);
+	if (!mode)
+		return 0;
+
+	mode->type |= DRM_MODE_TYPE_PREFERRED;
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static const struct drm_panel_funcs novatek_nt36536_panel_funcs = {
+	.prepare = novatek_nt36536_prepare,
+	.unprepare = novatek_nt36536_unprepare,
+	.get_modes = novatek_nt36536_get_modes,
+};
+
+static int novatek_nt36536_probe(struct mipi_dsi_device *dsi)
+{
+	struct mipi_dsi_device_info dsi_info = { "dsi-secondary", 0, NULL };
+	struct mipi_dsi_host *dsi1_host;
+	struct device *dev = &dsi->dev;
+	struct device_node *dsi1;
+	struct novatek_nt36536 *ctx;
+	int ret, i;
+
+	ctx = devm_drm_panel_alloc(dev, struct novatek_nt36536, panel,
+				   &novatek_nt36536_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->vddio = devm_regulator_get(dev, "vddio");
+	if (IS_ERR(ctx->vddio))
+		return dev_err_probe(dev, PTR_ERR(ctx->vddio),
+				     "failed to get vddio regulator\n");
+
+	ctx->vsp = devm_regulator_get(dev, "vsp");
+	if (IS_ERR(ctx->vsp))
+		return dev_err_probe(dev, PTR_ERR(ctx->vsp),
+				     "failed to get vsp regulator\n");
+
+	ctx->vsn = devm_regulator_get(dev, "vsn");
+	if (IS_ERR(ctx->vsn))
+		return dev_err_probe(dev, PTR_ERR(ctx->vsn),
+				     "failed to get vsn regulator\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "failed to get reset-gpios\n");
+
+	/* port@1 of the panel node points at the secondary DSI host */
+	dsi1 = of_graph_get_remote_node(dsi->dev.of_node, 1, -1);
+	if (!dsi1)
+		return dev_err_probe(dev, -ENODEV,
+				     "cannot get secondary DSI node\n");
+
+	dsi1_host = of_find_mipi_dsi_host_by_node(dsi1);
+	of_node_put(dsi1);
+	if (!dsi1_host)
+		return dev_err_probe(dev, -EPROBE_DEFER,
+				     "cannot get secondary DSI host\n");
+
+	ctx->dsi[1] = devm_mipi_dsi_device_register_full(dev, dsi1_host,
+							 &dsi_info);
+	if (IS_ERR(ctx->dsi[1]))
+		return dev_err_probe(dev, PTR_ERR(ctx->dsi[1]),
+				     "cannot get secondary DSI device\n");
+
+	ctx->dsi[0] = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+	mipi_dsi_set_drvdata(ctx->dsi[1], ctx);
+
+	ctx->panel.prepare_prev_first = true;
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	/* This panel only supports DSC; unconditionally enable it */
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 2;
+	ctx->dsc.slice_height = 20;
+	ctx->dsc.slice_width = 848;
+	ctx->dsc.slice_count = 1696 / ctx->dsc.slice_width;
+	ctx->dsc.bits_per_component = 8;
+	ctx->dsc.bits_per_pixel = 8 << 4; /* 4 fractional bits */
+	ctx->dsc.block_pred_enable = true;
+
+	for (i = 0; i < 2; i++) {
+		ctx->dsi[i]->lanes = 4;
+		ctx->dsi[i]->format = MIPI_DSI_FMT_RGB888;
+		/* Vendor stock keeps the DSI clock lane in continuous HS (no
+		 * NON_CONTINUOUS property in the panel dtsi); this DSC video
+		 * panel loses receiver lock if the clock lane drops to LP
+		 * during blanking, so match the vendor and run continuous. */
+		ctx->dsi[i]->mode_flags = MIPI_DSI_MODE_VIDEO |
+					  MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_DSC_ALL_SLICES_IN_PKT;
+		ctx->dsi[i]->dsc = &ctx->dsc;
+		/* vendor packs two 848-px slices into each video packet */
+
+		ret = devm_mipi_dsi_attach(dev, ctx->dsi[i]);
+		if (ret < 0) {
+			drm_panel_remove(&ctx->panel);
+			return dev_err_probe(dev, ret,
+					     "failed to attach to DSI host\n");
+		}
+	}
+
+	return 0;
+}
+
+static void novatek_nt36536_remove(struct mipi_dsi_device *dsi)
+{
+	struct novatek_nt36536 *ctx = mipi_dsi_get_drvdata(dsi);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id novatek_nt36536_of_match[] = {
+	{ .compatible = "csot,xn242" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, novatek_nt36536_of_match);
+
+static struct mipi_dsi_driver novatek_nt36536_driver = {
+	.probe = novatek_nt36536_probe,
+	.remove = novatek_nt36536_remove,
+	.driver = {
+		.name = "panel-novatek-nt36536-erhai",
+		.of_match_table = novatek_nt36536_of_match,
+	},
+};
+module_mipi_dsi_driver(novatek_nt36536_driver);
+
+MODULE_AUTHOR("yzddmr6 <46088090+yzddmr6@users.noreply.github.com>");
+MODULE_DESCRIPTION("Novatek NT36536 dual-DSI video mode panel driver");
+MODULE_LICENSE("GPL");
diff --git a/tools/testing/selftests/drm/dpu-output-dither-test.py b/tools/testing/selftests/drm/dpu-output-dither-test.py
new file mode 100644
index 000000000..1e227b624
--- /dev/null
+++ b/tools/testing/selftests/drm/dpu-output-dither-test.py
@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Compile the actual DPU dither helpers with fake bridge/MMIO boundaries.
+
+This covers opt-in/refcount handling and output configuration, not panel
+electrical operation or displayed colour accuracy. No GPU is required.
+"""
+import argparse
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+
+def function(source, name):
+    match = re.search(r"static\s+(?:bool|void)\s+" + name + r"\s*\(", source)
+    if not match:
+        raise ValueError(f"Missing function {name}")
+    start = source.index("{", match.start())
+    depth = 1
+    end = start + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[match.start():end]
+
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument("--source", type=Path, default=(Path(__file__).resolve().parents[4]
+                    / "drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c"))
+parser.add_argument("--cc", default="cc")
+args = parser.parse_args()
+source = args.source.read_text()
+matrix = re.search(r"static u32 dither_matrix\[DITHER_MATRIX_SZ\] = \{.*?\};", source, re.S)
+if matrix is None:
+    raise ValueError("Missing dither matrix")
+prefix = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#include <stdio.h>
+typedef uint32_t u32;
+#define DITHER_MATRIX_SZ 16
+struct device_node { bool enabled; };
+struct drm_bridge { struct device_node *of_node; unsigned refs; };
+struct drm_encoder { struct drm_bridge *last; };
+static struct drm_bridge *drm_bridge_chain_get_last_bridge(struct drm_encoder *e)
+{ if (e->last) ++e->last->refs; return e->last; }
+static void drm_bridge_put(struct drm_bridge *b)
+{ assert(b->refs == 2); --b->refs; }
+static bool of_property_read_bool(struct device_node *node, const char *name)
+{ assert(!strcmp(name, "qcom,dpu-8bpc-dither")); return node->enabled; }
+struct dpu_hw_dither_cfg {
+ unsigned c0_bitdepth, c1_bitdepth, c2_bitdepth, c3_bitdepth, temporal_en;
+ u32 matrix[DITHER_MATRIX_SZ];
+};
+struct dpu_hw_pingpong {
+ struct { void (*setup_dither)(struct dpu_hw_pingpong *, struct dpu_hw_dither_cfg *); } ops;
+};
+static unsigned calls;
+static bool disabled;
+static struct dpu_hw_dither_cfg applied;
+static void setup(struct dpu_hw_pingpong *pp, struct dpu_hw_dither_cfg *cfg)
+{ (void)pp; ++calls; disabled = !cfg; if (cfg) applied = *cfg; }
+'''
+suffix = r'''
+static void check_depth(unsigned depth)
+{
+ assert(!disabled);
+ assert(applied.c0_bitdepth == depth && applied.c1_bitdepth == depth);
+ assert(applied.c2_bitdepth == depth && applied.c3_bitdepth == depth);
+ assert(applied.temporal_en == 0);
+ assert(!memcmp(applied.matrix, dither_matrix, sizeof(dither_matrix)));
+ unsigned mask = 0;
+ for (unsigned i = 0; i < DITHER_MATRIX_SZ; ++i) {
+   assert(applied.matrix[i] < 16); mask |= 1U << applied.matrix[i];
+ }
+ assert(mask == 0xffff);
+}
+int main(void)
+{
+ struct drm_encoder enc = {0};
+ struct drm_bridge bridge = {.refs = 1};
+ struct device_node node = {0};
+ assert(!dpu_encoder_panel_dithers_8bpc(&enc));
+ enc.last = &bridge;
+ assert(!dpu_encoder_panel_dithers_8bpc(&enc) && bridge.refs == 1);
+ bridge.of_node = &node;
+ assert(!dpu_encoder_panel_dithers_8bpc(&enc) && bridge.refs == 1);
+ node.enabled = true;
+ assert(dpu_encoder_panel_dithers_8bpc(&enc) && bridge.refs == 1);
+ struct dpu_hw_pingpong pp = {.ops.setup_dither = setup};
+ _dpu_encoder_setup_dither(&pp, 6, false); check_depth(6);
+ _dpu_encoder_setup_dither(&pp, 8, false); assert(disabled);
+ _dpu_encoder_setup_dither(&pp, 8, true); check_depth(8);
+ _dpu_encoder_setup_dither(&pp, 10, true); assert(disabled);
+ _dpu_encoder_setup_dither(&pp, 0, true); assert(disabled);
+ assert(calls == 5);
+ pp.ops.setup_dither = NULL;
+ _dpu_encoder_setup_dither(&pp, 8, true); assert(calls == 5);
+ puts("PASS: panel opt-in, bridge references, 6/8/10-bpc policy, matrix and temporal-disable");
+}
+'''
+with tempfile.TemporaryDirectory(prefix="dpu-dither-test-") as tmp:
+    c = Path(tmp) / "test.c"
+    exe = Path(tmp) / "test"
+    c.write_text(prefix + matrix.group() + "\n" + function(source, "dpu_encoder_panel_dithers_8bpc")
+                 + "\n" + function(source, "_dpu_encoder_setup_dither") + suffix)
+    subprocess.run([args.cc, "-std=c11", "-Wall", "-Wextra", "-Werror", str(c), "-o", str(exe)], check=True)
+    subprocess.run([str(exe)], check=True)
