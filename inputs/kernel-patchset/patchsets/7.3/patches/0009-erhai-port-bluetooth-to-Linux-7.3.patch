 	config->dnld_type = QCA_SKIP_EVT_NONE;
 
 	switch (config->type) {
 	case ELF_TYPE_PATCH:
+		if (soc_type == QCA_BRAHMA_2_0 &&
+		    (fw_size < 52 || memcmp(fw_data, "\177ELF\1\1\1", 7)))
+			return -EINVAL;
 		if (fw_size < 7)
 			return -EINVAL;
 
@@ -325,6 +329,13 @@ static int qca_tlv_check_data(struct hci_dev *hdev,
 		tlv = (struct tlv_type_hdr *)fw_data;
 		type_len = le32_to_cpu(tlv->type_len);
 		tlv_patch = (struct tlv_type_patch *)tlv->data;
+		if (soc_type == QCA_BRAHMA_2_0 &&
+		    ((type_len & 0xff) != TLV_TYPE_PATCH ||
+		     (type_len >> 8) != fw_size - sizeof(*tlv) ||
+		     le16_to_cpu(tlv_patch->product_id) != 0x21 ||
+		     le16_to_cpu(tlv_patch->rom_build) != 0x0200))
+			return -EINVAL;
+
 
 		/* For Rome version 1.1 to 3.1, all segment commands
 		 * are acked by a vendor specific event (VSE).
@@ -369,6 +380,11 @@ static int qca_tlv_check_data(struct hci_dev *hdev,
 		type_len = le32_to_cpu(tlv->type_len);
 		length = type_len >> 8;
 		type = type_len & 0xff;
+		/* The captured Brahma 2.0 format has one unwrapped tag set. */
+		if (soc_type == QCA_BRAHMA_2_0 &&
+		    (type != 2 || length != fw_size - sizeof(*tlv)))
+			return -EINVAL;
+
 
 		/* Some NVM files have more than one set of tags, only parse
 		 * the first set when it has type 2 for now. When there is
@@ -416,6 +432,17 @@ static int qca_tlv_check_data(struct hci_dev *hdev,
 				break;
 
 			case EDL_TAG_ID_HCI:
+				if (soc_type == QCA_BRAHMA_2_0) {
+					/* Preserve the OEM UART tag. Its first byte is the
+					 * observed 8M selector; the older layout is different.
+					 */
+					if (brahma_uart_seen || tag_len != 6 ||
+					    nvm_baud_rate != QCA_BAUDRATE_8000000 ||
+					    tlv_nvm->data[0] != nvm_baud_rate)
+						return -EINVAL;
+					brahma_uart_seen = true;
+					break;
+				}
 				if (tag_len < 3)
 					return -EINVAL;
 
@@ -434,6 +461,13 @@ static int qca_tlv_check_data(struct hci_dev *hdev,
 				break;
 
 			case EDL_TAG_ID_DEEP_SLEEP:
+				if (soc_type == QCA_BRAHMA_2_0) {
+					if (brahma_sleep_seen || tag_len != 14 ||
+					    !(tlv_nvm->data[0] & 1))
+						return -EINVAL;
+					brahma_sleep_seen = true;
+					break;
+				}
 				if (tag_len < 1)
 					return -EINVAL;
 
@@ -447,6 +481,9 @@ static int qca_tlv_check_data(struct hci_dev *hdev,
 
 			idx += sizeof(struct tlv_type_nvm) + tag_len;
 		}
+		if (soc_type == QCA_BRAHMA_2_0 &&
+		    (idx != length || !brahma_uart_seen || !brahma_sleep_seen))
+			return -EINVAL;
 		break;
 
 	default:
@@ -559,6 +596,7 @@ static int qca_download_firmware(struct hci_dev *hdev,
 	u8 *data;
 	const u8 *segment;
 	int ret, size, remain, i = 0;
+	unsigned int trace_segments = 0, trace_bytes = 0;
 
 	bt_dev_info(hdev, "QCA Downloading %s", config->fwname);
 
@@ -567,7 +605,8 @@ static int qca_download_firmware(struct hci_dev *hdev,
 		/* If the board-specific file is missing, try loading the default
