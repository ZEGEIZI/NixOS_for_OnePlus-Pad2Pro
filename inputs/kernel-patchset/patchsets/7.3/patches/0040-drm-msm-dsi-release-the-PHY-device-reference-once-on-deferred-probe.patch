From 3ffa2748141c45cd43cc9bb86a9ceb3ec0b16098 Mon Sep 17 00:00:00 2001
From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Date: Sun, 1 Nov 2026 12:01:20 +0800
Subject: [PATCH] drm/msm/dsi: release the PHY device reference once on
 deferred probe

dsi_get_phy stores the reference returned by of_find_device_by_node in phy_dev. dsi_init already calls dsi_destroy on every subsequent failure, so dropping that reference in dsi_get_phy releases it twice when PHY drvdata is not ready. Leave the release to dsi_destroy and report dependency deferral through dev_err_probe.

Fixes: c04c3148ca12 ("drm/msm/dsi: Fix missing put_device() call in dsi_get_phy")

(cherry picked from commit b36b5181e9b479cb3f16aec914644441275a10ae)

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 drivers/gpu/drm/msm/dsi/dsi.c | 13 ++++---------
 1 file changed, 4 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/msm/dsi/dsi.c b/drivers/gpu/drm/msm/dsi/dsi.c
index 3c9f01ed6..4e07bc201 100644
--- a/drivers/gpu/drm/msm/dsi/dsi.c
+++ b/drivers/gpu/drm/msm/dsi/dsi.c
@@ -37,20 +37,15 @@ static int dsi_get_phy(struct msm_dsi *msm_dsi)
 	phy_pdev = of_find_device_by_node(phy_node);
 	if (phy_pdev) {
 		msm_dsi->phy = platform_get_drvdata(phy_pdev);
+		/* dsi_destroy() owns the reference, including on probe failure. */
 		msm_dsi->phy_dev = &phy_pdev->dev;
 	}
 
 	of_node_put(phy_node);
 
-	if (!phy_pdev) {
-		DRM_DEV_ERROR(&pdev->dev, "%s: phy driver is not ready\n", __func__);
-		return -EPROBE_DEFER;
-	}
-	if (!msm_dsi->phy) {
-		put_device(&phy_pdev->dev);
-		DRM_DEV_ERROR(&pdev->dev, "%s: phy driver is not ready\n", __func__);
-		return -EPROBE_DEFER;
-	}
+	if (!phy_pdev || !msm_dsi->phy)
+		return dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+				     "PHY driver is not ready\n");
 
 	return 0;
 }
