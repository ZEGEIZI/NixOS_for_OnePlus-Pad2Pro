diff --git a/drivers/soc/qcom/abl_root_identity.c b/drivers/soc/qcom/abl_root_identity.c
new file mode 100644
index 000000000..8dafcac65
--- /dev/null
+++ b/drivers/soc/qcom/abl_root_identity.c
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Restore the device tree root identity replaced by Qualcomm ABL.
+ *
+ * Some ABL builds copy the root "model" and "compatible" of the vendor DTBO
+ * they apply over those of the booted DTB. Root match tables (PD mapper, UBWC
+ * configuration, ...) then no longer recognise the SoC. A DTB that keeps its
+ * own identity in root properties the DTBO does not carry gets it back here,
+ * before the first core initcall. /sys/firmware/fdt keeps the ABL values.
+ */
+
+#define pr_fmt(fmt) "abl-root-identity: " fmt
+
+#include <linux/array_size.h>
+#include <linux/init.h>
+#include <linux/of.h>
+#include <linux/printk.h>
+#include <linux/string.h>
+
+struct abl_root_identity {
+	const char *saved;
+	const char *fallback;
+	struct property prop;
+};
+
+/* Linked into the live root node, so not __initdata. */
+static struct abl_root_identity abl_root_identity[] = {
+	{ .saved = "qcom,mainline-model",
+	  .fallback = "xiaomi,mainline-model", .prop.name = "model" },
+	{ .saved = "qcom,mainline-compatible",
+	  .fallback = "xiaomi,mainline-compatible", .prop.name = "compatible" },
+};
+
+/*
+ * Point @id->prop at the saved copy in @np. Returns 1 if it differs from the
+ * live property, 0 if they are equal, -ENOENT without a saved copy and another
+ * negative errno if the saved copy is not a non-empty string list.
+ */
+static int abl_root_identity_prepare(const struct device_node *np,
+				     struct abl_root_identity *id)
+{
+	const struct property *saved, *live;
+	const char *name = id->saved;
+	int ret;
+
+	saved = of_find_property(np, name, NULL);
+	if (!saved && id->fallback) {
+		name = id->fallback;
+		saved = of_find_property(np, name, NULL);
+	}
+	if (!saved)
+		return -ENOENT;
+
+	ret = of_property_count_strings(np, name);
+	if (ret < 0)
+		return ret;
+
+	live = of_find_property(np, id->prop.name, NULL);
+	if (live && live->length == saved->length &&
+	    !memcmp(live->value, saved->value, saved->length))
+		return 0;
+
+	id->prop.value = saved->value;
+	id->prop.length = saved->length;
+	return 1;
+}
+
+static int __init abl_root_identity_init(void)
+{
+	struct device_node *root __free(device_node) = of_find_node_by_path("/");
+	const char *model = "", *compatible = "";
+	unsigned int saved = 0, restored = 0;
+	int i, ret;
+
+	if (!root)
+		return 0;
+
+	/* Replaced properties stay on the node's deadprops list. */
+	of_property_read_string(root, "model", &model);
+	of_property_read_string(root, "compatible", &compatible);
+
+	for (i = 0; i < ARRAY_SIZE(abl_root_identity); i++) {
+		struct abl_root_identity *id = &abl_root_identity[i];
+
+		ret = abl_root_identity_prepare(root, id);
+		if (ret == -ENOENT)
+			continue;
+		if (ret < 0) {
+			pr_err("ignoring invalid %s: %d\n", id->saved, ret);
+			continue;
+		}
+		saved++;
+		if (ret && !of_update_property(root, &id->prop))
+			restored++;
+	}
+
+	if (restored) {
+		const char *new_model = "", *new_compatible = "";
+
+		of_property_read_string(root, "model", &new_model);
+		of_property_read_string(root, "compatible", &new_compatible);
+		pr_info("restored model \"%s\" -> \"%s\", compatible \"%s\" -> \"%s\"\n",
+			model, new_model, compatible, new_compatible);
+	} else if (saved) {
+		pr_info("root identity already matches the saved copy\n");
+	}
+
+	return 0;
+}
+early_initcall(abl_root_identity_init);
+
+#if IS_ENABLED(CONFIG_QCOM_ABL_ROOT_IDENTITY_KUNIT_TEST)
+#include "abl_root_identity_test.c"
+#endif
diff --git a/drivers/soc/qcom/abl_root_identity_test.c b/drivers/soc/qcom/abl_root_identity_test.c
new file mode 100644
index 000000000..e1e798e32
--- /dev/null
+++ b/drivers/soc/qcom/abl_root_identity_test.c
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Included by abl_root_identity.c. Uses unattached synthetic nodes; the
+ * of_update_property() step on the live root is left to boot testing.
+ */
+#include <kunit/test.h>
+
+static const char abl_test_stock[] = "qcom,sun-mtp\0qcom,sun\0qcom,mtp";
+static const char abl_test_mainline[] = "xiaomi,piano\0qcom,sm8750";
+
+static void abl_test_add(struct kunit *test, struct device_node *np,
+			 const char *name, const void *value, int length)
+{
+	struct property *prop = kunit_kzalloc(test, sizeof(*prop), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, prop);
+	prop->name = (char *)name;
+	prop->value = (void *)value;
+	prop->length = length;
+	prop->next = np->properties;
+	np->properties = prop;
+}
+
+static struct abl_root_identity abl_test_compatible(void)
+{
+	return (struct abl_root_identity) {
+		.saved = "xiaomi,mainline-compatible",
+		.prop.name = "compatible",
+	};
+}
+
+static void abl_test_restore_replaced(struct kunit *test)
+{
+	struct abl_root_identity id = abl_test_compatible();
+	struct device_node np = {};
+
+	abl_test_add(test, &np, "compatible", abl_test_stock, sizeof(abl_test_stock));
+	abl_test_add(test, &np, id.saved, abl_test_mainline, sizeof(abl_test_mainline));
+
+	KUNIT_EXPECT_EQ(test, abl_root_identity_prepare(&np, &id), 1);
+	KUNIT_EXPECT_PTR_EQ(test, id.prop.value, (void *)abl_test_mainline);
+	KUNIT_EXPECT_EQ(test, id.prop.length, (int)sizeof(abl_test_mainline));
+	KUNIT_EXPECT_STREQ(test, id.prop.name, "compatible");
+}
+
+static void abl_test_restore_missing_live(struct kunit *test)
+{
+	struct abl_root_identity id = {
+		.saved = "xiaomi,mainline-model",
+		.prop.name = "model",
+	};
+	static const char model[] = "Xiaomi Pad 8 Pro";
+	struct device_node np = {};
+
+	abl_test_add(test, &np, id.saved, model, sizeof(model));
+
+	KUNIT_EXPECT_EQ(test, abl_root_identity_prepare(&np, &id), 1);
+	KUNIT_EXPECT_PTR_EQ(test, id.prop.value, (void *)model);
+}
+
+static void abl_test_keep_matching(struct kunit *test)
+{
+	struct abl_root_identity id = abl_test_compatible();
+	static const char copy[] = "xiaomi,piano\0qcom,sm8750";
+	struct device_node np = {};
+
+	abl_test_add(test, &np, "compatible", copy, sizeof(copy));
+	abl_test_add(test, &np, id.saved, abl_test_mainline, sizeof(abl_test_mainline));
+
+	KUNIT_EXPECT_EQ(test, abl_root_identity_prepare(&np, &id), 0);
+	KUNIT_EXPECT_NULL(test, id.prop.value);
+}
+
+static void abl_test_no_saved_copy(struct kunit *test)
+{
+	struct abl_root_identity id = abl_test_compatible();
+	struct device_node np = {};
+
+	abl_test_add(test, &np, "compatible", abl_test_stock, sizeof(abl_test_stock));
+
+	KUNIT_EXPECT_EQ(test, abl_root_identity_prepare(&np, &id), -ENOENT);
+	KUNIT_EXPECT_NULL(test, id.prop.value);
+}
+
+static void abl_test_reject_invalid(struct kunit *test)
+{
+	struct abl_root_identity id = abl_test_compatible();
+	static const char unterminated[] = { 'x', 'i', 'a', 'o', 'm', 'i' };
+	struct device_node np = {};
+
+	abl_test_add(test, &np, "compatible", abl_test_stock, sizeof(abl_test_stock));
+	abl_test_add(test, &np, id.saved, unterminated, sizeof(unterminated));
+	KUNIT_EXPECT_EQ(test, abl_root_identity_prepare(&np, &id), -EILSEQ);
+	KUNIT_EXPECT_NULL(test, id.prop.value);
+
+	np.properties = NULL;
+	abl_test_add(test, &np, "compatible", abl_test_stock, sizeof(abl_test_stock));
+	abl_test_add(test, &np, id.saved, abl_test_mainline, 0);
+	KUNIT_EXPECT_EQ(test, abl_root_identity_prepare(&np, &id), -ENODATA);
+	KUNIT_EXPECT_NULL(test, id.prop.value);
+}
+
+static struct kunit_case abl_root_identity_cases[] = {
+	KUNIT_CASE(abl_test_restore_replaced),
+	KUNIT_CASE(abl_test_restore_missing_live),
+	KUNIT_CASE(abl_test_keep_matching),
+	KUNIT_CASE(abl_test_no_saved_copy),
+	KUNIT_CASE(abl_test_reject_invalid),
+	{}
+};
+
+static struct kunit_suite abl_root_identity_suite = {
+	.name = "qcom-abl-root-identity",
+	.test_cases = abl_root_identity_cases,
+};
+kunit_test_suite(abl_root_identity_suite);
diff --git a/drivers/soc/qcom/apr.c b/drivers/soc/qcom/apr.c
index ea7f83916..8fe72daa2 100644
--- a/drivers/soc/qcom/apr.c
+++ b/drivers/soc/qcom/apr.c
@@ -367,9 +367,19 @@ static int apr_device_probe(struct device *dev)
 	struct apr_driver *adrv = to_apr_driver(dev->driver);
 	int ret;
 
+	/*
+	 * Install the response callback before probing. A driver may issue a
+	 * synchronous request from its own probe - q6apm asks the DSP for the
+	 * SPF state - and the reply can arrive while probe is still running.
+	 * gpr_do_rx_callback() drops packets for a service with no callback,
+	 * so setting it afterwards loses that reply and the request always
+	 * times out, no matter how long it waits.
+	 */
+	adev->svc.callback = adrv->gpr_callback;
+
 	ret = adrv->probe(adev);
-	if (!ret)
-		adev->svc.callback = adrv->gpr_callback;
+	if (ret)
+		adev->svc.callback = NULL;
 
 	return ret;
 }
