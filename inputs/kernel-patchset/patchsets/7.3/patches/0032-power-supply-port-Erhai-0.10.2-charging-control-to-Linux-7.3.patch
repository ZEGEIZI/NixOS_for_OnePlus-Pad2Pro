+	if (apdo <= 0)
+		return apdo;
+	if (ma <= 0)
+		ma = min(pps_cable_safe_ma, 3000U);
+	return min3(min(pps_target_curr_ma, pps_max_curr_ma), (unsigned int)min(ma, apdo), 5000U);
+}
