+					    &b->buck_fcc_applied);
+		if (ret)
+			return ret;
+	} else if (b->buck_saved_fcc_valid) {
+		ret = qcom_battmgr_buck_write(b, BATT_CHG_CTRL_LIM, b->buck_saved_fcc_ua,
