+static int qcom_battmgr_buck_write(struct qcom_battmgr *b, unsigned int property,
+				 int value, int *applied)
+{
+	int ret;
+
+	if (*applied == value)
+		return 0;
+	*applied = -1;
+	ret = qcom_battmgr_set_property(b, BATTMGR_BAT_PROPERTY_SET, property, value);
+	if (!ret)
+		*applied = value;
+	return ret;
+}
