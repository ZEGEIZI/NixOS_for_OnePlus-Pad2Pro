+
+	spin_lock(&ufcs->class->err_flag_lock);
+	rc = kfifo_out(&ufcs->err_flag_fifo, err_flag, sizeof(*err_flag));
+	spin_unlock(&ufcs->class->err_flag_lock);
+	if (rc != sizeof(*err_flag)) {
+		ufcs_err("read err_flag_fifo error, rc=%d\n", rc);
+		return -EFAULT;
+	}
+
+	return 0;
+}
