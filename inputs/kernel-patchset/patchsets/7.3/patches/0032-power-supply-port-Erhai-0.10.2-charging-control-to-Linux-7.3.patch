+void ufcs_clr_error_flag(struct ufcs_dev *ufcs)
+{
+	if (ufcs == NULL) {
+		ufcs_err("ufcs is NULL\n");
+		return;
+	}
+
+	spin_lock(&ufcs->class->err_flag_lock);
+	ufcs->err_flag_save = 0;
+	kfifo_reset(&ufcs->err_flag_fifo);
+	spin_unlock(&ufcs->class->err_flag_lock);
+}
