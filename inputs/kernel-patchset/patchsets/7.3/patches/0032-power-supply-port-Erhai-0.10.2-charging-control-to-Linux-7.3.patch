+static void qcom_battmgr_buck_invalidate(struct qcom_battmgr *b)
+{
+	b->buck_fv_applied = b->buck_fcc_applied = -1;
+	b->buck_enable_applied = b->buck_para_applied = -1;
+	b->buck_full_applied = -1;
