+static inline int erhai_cell_cv(int temp)
+{
+	/* oplus_spec,full_voltage: sustained (second) threshold per region. */
+	if (temp >= 440)
+		return 4130;
+	if (temp < 50)
+		return 4520;
+	if (temp >= 210 && temp < 350)
+		return 4550;
+	return 4545;
+}
+
+/* The board table encodes 2:1 bus mA. Other converters apply the
+ * corresponding battery-side limit, regardless of negotiated voltage.
+ */
+static inline const struct erhai_charge_step *
+erhai_cell_entry(int soc, int temp, int mv)
+{
+	const struct erhai_charge_curve *curve = erhai_curve_select(svooc_curves, soc, temp);
+
+	if (!curve || mv <= 0 || mv >= erhai_cell_cv(temp))
+		return NULL;
+	return &curve->steps[erhai_curve_start(curve, mv, true)];
+}
+#endif
diff --git a/drivers/power/supply/erhai_charge_curve.h b/drivers/power/supply/erhai_charge_curve.h
new file mode 100644
index 000000000..8fd426971
--- /dev/null
+++ b/drivers/power/supply/erhai_charge_curve.h
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ERHAI_CHARGE_CURVE_H
+#define _ERHAI_CHARGE_CURVE_H
+
+#include <linux/kernel.h>
+
+struct erhai_charge_step {
+	u16 mv;
+	u16 ma;		/* bus current, before adapter and cable limits */
+	bool last;
+};
+
+struct erhai_charge_curve {
+	const struct erhai_charge_step *steps;
+	u8 count;
+};
+
+#define ERHAI_CURVE(rows) { rows, ARRAY_SIZE(rows) }
+
+/* Project 24926 includes oplus-chg-24924.dtsi and erhai-common.
+ * soc_range upper bounds are inclusive, temp_range bounds exclusive.
+ * Above the final SOC boundary keep the last curve until physical CV.
+ * Use gauge temperature in deci-C regardless of display state.
+ */
+static inline const struct erhai_charge_curve *
+erhai_curve_select(const struct erhai_charge_curve curves[][7],
+		   int soc, int temp)
+{
+	static const int soc_end[] = { 20, 35, 55, 75, 85, 90 };
+	static const int temp_end[] = { 50, 120, 160, 210, 350, 440, 510 };
+	unsigned int s, t;
+
+	if (soc < 0 || soc > 100 || temp < 0)
+		return NULL;
+	for (s = 0; s + 1 < ARRAY_SIZE(soc_end); s++)
+		if (soc <= soc_end[s])
+			break;
+	for (t = 0; t < ARRAY_SIZE(temp_end); t++)
+		if (temp < temp_end[t])
+			break;
+	if (t == ARRAY_SIZE(temp_end))
+		return NULL;
+	return &curves[s][t];
+}
+
+/* oplus_chg_comm.h BATT_TEMP_HYST = 20 deci-C. Retain the previous
+ * region near a boundary. The caller also applies the raw region's
+ * voltage/current limits immediately when they are tighter.
+ */
+static inline int erhai_curve_temp(int last, int temp)
+{
+	static const int bounds[] = { 0, 50, 120, 160, 210, 350, 440, 510 };
+	unsigned int i;
+
+	for (i = 1; i < ARRAY_SIZE(bounds); i++) {
+		if (last >= bounds[i - 1] && last < bounds[i]) {
+			if (temp >= bounds[i - 1] - 20 && temp < bounds[i] + 20)
+				return last;
+			break;
+		}
+	}
+	return temp;
+}
+
+/* PPS starts below its voltage target, SUPERVOOC also accepts equality. */
+static inline unsigned int erhai_curve_start(const struct erhai_charge_curve *curve,
+					    int mv, bool inclusive)
+{
+	unsigned int i;
+
+	for (i = 0; i + 1 < curve->count; i++)
+		if (mv < curve->steps[i].mv || (inclusive && mv == curve->steps[i].mv))
+			break;
+	return i;
+}
+#endif
