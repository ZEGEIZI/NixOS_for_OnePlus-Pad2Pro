+static int pps_source_limit(u32 *selected, bool *grant_known)
+{
+	int ma = pps_usb_get(PPS_PROP_USB_GET_PPS_MAX_CURR);
+	int apdo = erhai_pps_apdo_current(pps_vbat_min_mv * 2 + 100, pps_cp_max_volt_mv, selected);
