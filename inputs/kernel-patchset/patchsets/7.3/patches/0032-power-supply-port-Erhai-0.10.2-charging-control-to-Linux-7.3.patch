+	memset(class->pdo.data, 0, sizeof(class->pdo.data));
+	memset(class->verify_info.random_data, 0, sizeof(class->verify_info.random_data));
+	memset(class->verify_info.auth_data, 0, sizeof(class->verify_info.auth_data));
