+	UFCS_BAUD_19200,
+	UFCS_BAUD_MAX,
+};
+
+enum ufcs_handshake_state {
+	UFCS_HS_IDLE = 0,
+	UFCS_HS_WAIT,
+	UFCS_HS_SUCCESS,
+	UFCS_HS_FAIL,
+	UFCS_HS_TIMEOUT,
+};
+
+enum ufcs_err_type {
+	UFCS_HW_ERR = 0,
+	UFCS_HW_ERR_DP_OVP = UFCS_HW_ERR,
+	UFCS_HW_ERR_DM_OVP,
+	UFCS_HW_ERR_TEMP_SHUTDOWN,
