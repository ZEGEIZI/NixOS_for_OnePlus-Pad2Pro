From 9a8a4ab32c023cf2fc4c6df2f113f0e23f7f9165 Mon Sep 17 00:00:00 2001
From: Erhai patchset migration <erhai-patchset@localhost>
Date: Fri, 13 Nov 2026 21:47:41 +0800
Subject: [PATCH] arm64: erhai: keep rfkill built in with the Bluetooth stack

---
 arch/arm64/configs/erhai-firstboot.config | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/configs/erhai-firstboot.config b/arch/arm64/configs/erhai-firstboot.config
index 02a67a16e..1e55a2c28 100644
--- a/arch/arm64/configs/erhai-firstboot.config
+++ b/arch/arm64/configs/erhai-firstboot.config
@@ -234,6 +234,7 @@ CONFIG_PHY_QCOM_QMP_PCIE=y
 CONFIG_POWER_RESET_QCOM_PON=y
 
 # Bluetooth (WCN7860) over uart14 serdev; the RAM desktop has no module tree.
+CONFIG_RFKILL=y
 CONFIG_BT=y
 CONFIG_BT_HCIUART=y
 CONFIG_BT_HCIUART_QCA=y
