+static void qcom_battmgr_charge_wake_remove(void *data)
+{
+	struct qcom_battmgr *battmgr = data;
+
+	__pm_relax(battmgr->charge_ws);
+	wakeup_source_unregister(battmgr->charge_ws);
+}
