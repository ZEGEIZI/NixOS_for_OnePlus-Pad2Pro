+/* Fixed PDOs and PPS share a worker and never write the contract concurrently. */
+static unsigned int qcom_battmgr_pd_update(struct qcom_battmgr *battmgr)
+{
+	struct qcom_battmgr_pd_source src = { .battmgr = battmgr };
