+	seq_printf(m, "vbus_mV %d\nibus_mA %d\nvbat_mV %d\n",
+		   sc8547_get_vbus(sc), sc8547_get_ibus(sc), sc8547_get_vbat(sc));
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(sc8547_adc);
